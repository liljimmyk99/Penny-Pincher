# Serves the built SPA inside the web container (plain HTTP; TLS is the proxy's job).
# Listens on :8080 because the container runs as a non-root user with every
# capability dropped, which can't bind ports below 1024 (#109).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	# Hashed build assets can be cached forever; index.html must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	# Not hashed, so a new build must be picked up on the next load.
	header /theme-init.js Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
