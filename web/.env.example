# Copy to .env.local for `npm run dev` (git-ignored). Docker builds get these
# as build args from the root .env instead (see docker-compose.yml).
#
# Firebase console → Project settings → General → Your apps → Web app → config.
# The web API key is public by design (it identifies the project, it grants no
# access), but keep it out of git with the rest of the deployment settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to <project id>.firebaseapp.com.
VITE_FIREBASE_AUTH_DOMAIN=
