# Copy to .env and edit. .env is git-ignored; never commit secrets.

# Which stack to run: "dev" (localhost) or "prod" (real domain).
COMPOSE_PROFILES=dev

# prod only: public hostname and Let's Encrypt contact email.
DOMAIN=
ACME_EMAIL=

# API (path inside the container; lives on the api-data volume).
DB_PATH=/data/spend.db

# Firebase project whose ID tokens the API verifies (required).
FIREBASE_PROJECT_ID=penny-pincher-d52aa

# Web app's Firebase config (Project settings -> General -> Your apps -> Web app).
# The web API key is public by design; it identifies the project and grants no access.
FIREBASE_WEB_API_KEY=
# Optional; defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com.
FIREBASE_AUTH_DOMAIN=
