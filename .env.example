# Copy to .env and edit. .env is git-ignored; never commit secrets.

# Which stack to run: "dev" (localhost) or "prod" (real domain).
COMPOSE_PROFILES=dev

# prod only: hostname and Let's Encrypt contact email. On a tailnet-only host
# DOMAIN is the machine's <host>.<tailnet>.ts.net name (docs/tailscale.md).
DOMAIN=
ACME_EMAIL=

# Tailnet host only: host folder with the `tailscale cert` files and a tls.caddy
# that names them (docs/tailscale.md). Leave empty to let Caddy get its own certificate.
TLS_DIR=

# API (path inside the container; lives on the api-data volume).
DB_PATH=/data/spend.db

# Encrypted backups to an S3-compatible bucket (see docs/backups.md).
# Leave BACKUP_AGE_RECIPIENT empty to disable. It is the age PUBLIC key (age1...);
# keep the private key offline, never on the server.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
