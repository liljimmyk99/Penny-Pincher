# Copy to .env and edit. .env is git-ignored; never commit secrets.

# Which stack to run: "dev" (localhost) or "prod" (real domain).
COMPOSE_PROFILES=dev

# prod only: public hostname and Let's Encrypt contact email.
DOMAIN=
ACME_EMAIL=

# API (path inside the container; lives on the api-data volume).
DB_PATH=/data/spend.db

# Firebase project whose ID tokens the API verifies (required).
FIREBASE_PROJECT_ID=penny-pincher-d52aa

# Web app's Firebase config (Project settings -> General -> Your apps -> Web app).
# The web API key is public by design; it identifies the project and grants no access.
FIREBASE_WEB_API_KEY=
# Optional; defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com. The proxy's
# Content-Security-Policy allows the Google sign-in iframe from this domain.
FIREBASE_AUTH_DOMAIN=

# Encrypted backups to an S3-compatible bucket (see docs/backups.md).
# Leave BACKUP_AGE_RECIPIENT empty to disable. It is the age PUBLIC key (age1...);
# keep the private key offline, never on the server.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
