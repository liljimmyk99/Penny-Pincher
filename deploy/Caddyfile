{
	# ACME_EMAIL is only meaningful in prod; the default keeps dev parsing.
	email {$ACME_EMAIL:admin@localhost}

	# On localhost Caddy's internal CA would install its root into the
	# container's own trust store, which is pointless and fails on the
	# read-only filesystem (#109). Browsers are told to trust it separately.
	skip_install_trust

	# Slow clients (Slowloris) are cut off at the edge, which faces the
	# internet. No write timeout: SSE import progress and backup downloads
	# stream for as long as they need (the API sets write deadlines per route).
	servers {
		timeouts {
			read_header 10s
			read_body 2m
			idle 2m
		}
	}
}

# localhost gets a certificate from Caddy's internal CA automatically;
# a real domain gets one from Let's Encrypt.
{$DOMAIN} {
	# HSTS: once a browser has seen this, it refuses plain HTTP to the host for
	# a year, so a first visit can't be downgraded. Not sent for localhost (dev
	# and e2e), where browsers would apply it to every local server on any port.
	# No includeSubDomains: other subdomains of DOMAIN are not ours to force.
	# Access log: one JSON line per request to stdout, which Docker keeps and
	# rotates (docker-compose.yml). Query strings are cut from the URI, because
	# they can carry financial data (the trends ?text= filter matches note
	# text), and so is the Referer, which holds the full previous URL for
	# same-origin requests. Credentials are dropped entirely (#110).
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.*$ ""
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Referer delete
			resp_headers>Set-Cookie delete
		}
	}

	@hsts not host localhost
	header @hsts Strict-Transport-Security "max-age=31536000"

	# Browser security headers on every response (docs/security.md). Deferred,
	# so they are applied as the response is written, after the upstreams' own
	# headers. Server and Via (which name Caddy) are removed.
	#
	# Content-Security-Policy, one directive per concern:
	#   script-src   our bundle and theme-init.js; apis.google.com is the loader
	#                the Firebase Auth popup uses (no inline script, no eval)
	#   connect-src  the API (same origin) and Firebase Auth's token endpoints
	#   frame-src    the Firebase auth domain's hidden iframe for the popup
	#   style-src    our CSS and the Google Fonts stylesheet; font-src its files
	#   frame-ancestors 'none'  no other site may frame the app (clickjacking)
	# FIREBASE_AUTH_DOMAIN is <project>.firebaseapp.com unless .env overrides it.
	# FIREBASE_AUTH_EMULATOR_URL is set by the e2e stack only (e2e/compose.yml)
	# and is empty everywhere else.
	header {
		defer
		Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com {$FIREBASE_AUTH_EMULATOR_URL}; frame-src https://{$FIREBASE_AUTH_DOMAIN} {$FIREBASE_AUTH_EMULATOR_URL}; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# frame-ancestors for browsers that predate it.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Isolates the window from cross-origin openers, but keeps the opener
		# link to popups we open, which the Google sign-in popup needs.
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
		-Via
	}

	# API and health check go to the backend; everything else is the web app.
	@api path /v1/* /healthz
	# Financial data must not be kept in the browser's or any shared cache.
	header @api {
		defer
		Cache-Control "no-store"
	}
	handle @api {
		# A backstop for the API's own caps (1 MB, 11 MiB for the import
		# upload), which answer with the JSON error body. Caddy's 413 has none.
		request_body {
			max_size 12MiB
		}
		# flush_interval -1 sends every write at once, so import progress
		# (text/event-stream) arrives live and is never buffered.
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:8080
	}
}
