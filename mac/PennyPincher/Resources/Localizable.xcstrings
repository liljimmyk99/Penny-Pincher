    "config.problem.emulatorNeedsDemoProject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIREBASE_AUTH_EMULATOR_HOST is set, but FIREBASE_PROJECT_ID does not start with \"demo-\". The emulator is for local testing only."
          }
        }
      }
    },
    "config.problem.insecureServerURL %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PP_SERVER_URL (%@) must use https. Plain http is allowed only for localhost."
          }
        }
      }
    },
    "config.problem.invalidEmulatorHost %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIREBASE_AUTH_EMULATOR_HOST (%@) must be host:port."
