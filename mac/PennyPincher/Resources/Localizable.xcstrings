    "auth.error.accountExists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email signs in with a password. Use email and password instead."
          }
        }
      }
    },
    "auth.error.googleUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google sign-in isn't set up for this app yet. Use email and password instead."
          }
        }
      }
    },
    "auth.error.invalidCredentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email and password don't match. Check them and try again, or reset your password."
          }
        }
      }
    },
    "auth.error.invalidEmail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address."
          }
        }
      }
    },
    "auth.error.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the sign-in service. Check your connection and try again."
          }
        }
